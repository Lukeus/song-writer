{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/analyzer", "sidecar": true, "args": true },
        { "name": "python3", "cmd": "python3", "args": true },
        { "name": "ffmpeg", "cmd": "ffmpeg", "args": true }
      ]
    }
  ]
}
